{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TypePro",
  "version": "1.1.0",
  "identifier": "com.localnotes.notebook",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TypePro",
        "width": 1180,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560,
        "backgroundColor": "#FFFFFF",
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' tauri://localhost http://tauri.localhost https://tauri.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; font-src 'self' data:; connect-src ipc: http://ipc.localhost 'self' https:; frame-src 'self' blob:; worker-src blob:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "本地 Markdown 笔记",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "android": {
      "minSdkVersion": 26,
      "versionCode": 1001000
    }
  }
}
